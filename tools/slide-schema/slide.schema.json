{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRIME King Tamar Slide Schema",
  "type": "object",
  "required": ["slide_id", "project", "role", "source_layer", "colorway", "headline", "subtitle", "cards", "qa"],
  "properties": {
    "slide_id": { "type": "string" },
    "project": { "type": "string", "const": "King Tamar" },
    "role": { "type": "string" },
    "source_layer": {
      "type": "string",
      "enum": ["Client Copy V6", "Sales Playbook V6", "Appendix", "Marketing Asset", "Internal Training"]
    },
    "colorway": {
      "type": "string",
      "enum": ["light", "dark"]
    },
    "headline": { "type": "string", "minLength": 2, "maxLength": 80 },
    "subtitle": { "type": "string", "maxLength": 140 },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 35 },
          "body": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "message_line": { "type": "string", "maxLength": 160 },
    "source_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "visual": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["Strategic Light Board", "Authority Dark", "Premium Photo Narrative", "Hero Product Slide", "KPI Board", "Trust Triangle"] },
        "image_path": { "type": "string" },
        "layout": { "type": "string" }
      }
    },
    "qa": {
      "type": "object",
      "required": ["rtl", "no_invented_data", "no_guarantees", "client_screen_only"],
      "properties": {
        "rtl": { "type": "boolean" },
        "no_invented_data": { "type": "boolean" },
        "no_guarantees": { "type": "boolean" },
        "client_screen_only": { "type": "boolean" }
      }
    }
  }
}
